{
  "id": "/dashboard",
  "name": "Contextra Monitor",
  "short_name": "Monitor",
  "description": "Private editorial monitoring, review, automation, and publishing workspace.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
